# Netlify environment variables. Real values are set in Netlify, never committed.
# Posting stays off until these are configured.

# Master switch. Anything other than "true" blocks external posting.
LEAD_SUBMISSION_ENABLED=false

# "true" sends lead[test]=true (LeadHoop accepts but does not deliver). Set "false" only for live launch.
LEAD_TEST_MODE=true

# Production site origin, e.g. https://example.com (no path). Used for the Origin check,
# lead[signup_url], and lead[consent_url] validation. Intentionally blank here.
SITE_URL=

# Server-only LeadHoop campaign code (from the posting specs). Do not commit the real value.
LEADHOOP_CAMPAIGN_CODE=
